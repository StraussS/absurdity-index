# Root project ignores
.DS_Store
*.log

# Local editor / OS
.vscode/
.idea/

# Web app artifacts
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel/
web/*.tsbuildinfo

# Local environment files
web/.env.local
web/.env*.local

# Runtime caches generated by the scoring pipeline
web/data/ai-cache/
web/data/translation-cache/

# Optional generated share/debug assets
web/public/share/*.png
web/public/share/*.jpg
web/public/share/*.jpeg
